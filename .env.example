# Copy to .env for local development. Render sets these from render.yaml instead.

# Required
DATABASE_URL=postgres://trupath:trupath@127.0.0.1:56432/trupath
APP_URL=http://localhost:3000

# Encrypts Shopify tokens and client secrets stored in the database. Any long random string; keep it stable.
# (Falls back to SHOPIFY_CLIENT_SECRET when unset, but a dedicated key survives rotating that secret.)
APP_ENCRYPTION_KEY=change-me-to-a-long-random-string

# First owner login (used only when no users exist yet; change it after signing in)
SEED_OWNER_EMAIL=owner@trupaths.in
SEED_OWNER_PASSWORD=change-me-now
SEED_OWNER_NAME=Owner

# Shopify: optional here; per-store credentials can be entered under Settings -> Shopify instead.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Legacy custom-app token (only if the store still offers Settings -> Apps -> Develop apps)
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_API_VERSION=2026-07
# Background sync interval in minutes; 0 disables it (then call /api/cron/shopify-sync?key=CRON_SECRET from an external cron)
SHOPIFY_SYNC_MINUTES=15
CRON_SECRET=

# Optional
# DATABASE_SSL=require        # force TLS for external database URLs
# DATABASE_POOL_MAX=8         # connection pool size
# COOKIE_SECURE=false         # set to false to test a production build over plain http
# STOCK_BASELINE=2026-09-01T00:00:00Z   # override for `pnpm stock:undo-import`
TZ=Asia/Kolkata
